{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "assets/js",
    "rootDir": "assets/ts",
    "sourceMap": true
  },
  "include": ["assets/ts/**/*.ts"]
}
